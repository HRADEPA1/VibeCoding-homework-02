import json, sys
s = json.load(sys.stdin)
plan = s['plan']
done = sum(1 for st in plan['steps'] if st['status']=='done')
active = [st for st in plan['steps'] if st['status']=='active']
print(f'Plan: {plan[\"status\"]} | Done: {done}/18 | Active: {[a[\"name\"] for a in active]}')
for step in plan['steps']:
    icon = {'done':'✓','active':'▶','pending':'○','failed':'✗'}.get(step['status'],'?')
    dur = f' {step[\"duration_ms\"]/1000:.1f}s' if step['duration_ms'] else ''
    print(f'  {icon} {step[\"step_index\"]:2}. {step[\"name\"]}{dur}')
" 2>&1 | head -30
