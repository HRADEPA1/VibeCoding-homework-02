{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "mcpServers": {

    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        ".",
        "./data",
        "./src",
        "./docs"
      ],
      "description": "Local filesystem access scoped to project directories"
    },

    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "description": "GitHub API: search code, manage issues/PRs, read repo contents"
    },

    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "description": "Real-time web search via Brave Search API"
    },

    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "--db-path",
        "./data/research.db"
      ],
      "description": "SQLite database for persisting research findings and session state"
    },

    "research-mcp": {
      "command": "node",
      "args": ["./mcp-servers/research-mcp/server.js"],
      "env": {
        "ARXIV_BASE_URL": "https://export.arxiv.org/api/query",
        "MAX_RESULTS": "10",
        "ABSTRACT_MAX_CHARS": "800",
        "LOG_FILE": "./data/logs/research-mcp.log",
        "LOG_LEVEL": "info"
      },
      "description": "Custom MCP: arXiv paper fetching, summarization, structured finding storage"
    }

  },

  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(uv:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Bash(curl:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Read(**)",
      "Write(src/**)",
      "Write(docs/**)",
      "Write(data/**)",
      "Write(.claude/**)",
      "Edit(src/**)",
      "Edit(docs/**)",
      "Edit(CLAUDE.md)",
      "Edit(mcp-servers/**)",
      "WebFetch(*)",
      "WebSearch(*)",
      "mcp__filesystem__*",
      "mcp__github__*",
      "mcp__brave-search__*",
      "mcp__sqlite__*",
      "mcp__research-mcp__*"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo:*)",
      "Bash(curl * | bash)",
      "Write(/etc/**)",
      "Write(/usr/**)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" + \"\\tPRE\\tBash\\t\" + (.tool_input.command // \"unknown\")' >> .claude/logs/agent.log 2>/dev/null; true"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" + \"\\tPRE\\tWrite\\t\" + (.tool_input.file_path // \"unknown\")' >> .claude/logs/agent.log 2>/dev/null; true"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" + \"\\tPRE\\tEdit\\t\" + (.tool_input.file_path // \"unknown\")' >> .claude/logs/agent.log 2>/dev/null; true"
          }
        ]
      },
      {
        "matcher": "mcp__research-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" + \"\\tPRE\\tMCP-research\\t\" + (.tool_name // \"unknown\")' >> .claude/logs/agent.log 2>/dev/null; true"
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" + \"\\tPOST\\tBash\\tOK\"' >> .claude/logs/agent.log 2>/dev/null; true"
          }
        ]
      },
      {
        "matcher": "mcp__research-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" + \"\\tPOST\\tMCP-research\\tOK\"' >> .claude/logs/agent.log 2>/dev/null; true"
          }
        ]
      }
    ],

    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" + \"\\tERROR\\tBash\\t\" + (.tool_input.command // \"unknown\")' | tee -a .claude/logs/agent.log >> .claude/logs/errors.log 2>/dev/null; true"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" + \"\\tERROR\\tWrite\\t\" + (.tool_input.file_path // \"unknown\")' >> .claude/logs/errors.log 2>/dev/null; true"
          }
        ]
      },
      {
        "matcher": "mcp__research-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" + \"\\tERROR\\tMCP-research\\t\" + (.tool_name // \"unknown\")' >> .claude/logs/errors.log 2>/dev/null; true"
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\tSESSION_END\\tClaude session finished\\n' \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" >> .claude/logs/agent.log 2>/dev/null; true"
          }
        ]
      }
    ]
  },

  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "NODE_ENV": "development"
  },

  "includeCoAuthoredBy": true,
  "cleanupPeriodDays": 30,
  "autoCompact": true
}
