# Capability Matcher — environment variable reference
# Copy to .env and fill in values for local development.
# Never commit .env to version control.

# ── TypeDB ────────────────────────────────────────────────────────────────────
TYPEDB_HOST=localhost
TYPEDB_PORT=1729
TYPEDB_DB=capability_kg
TYPEDB_USERNAME=admin
TYPEDB_PASSWORD=password

# ── OPC UA ───────────────────────────────────────────────────────────────────
# Mode A/B (mock): opc.tcp://localhost:4840/ricaip
# Mode C (live testbed): opc.tcp://<plc-ip>:4840
OPCUA_ENDPOINT=opc.tcp://localhost:4840/ricaip

# ── Execution mode ────────────────────────────────────────────────────────────
# A = file-based (no OPC UA)
# B = planning / dry-run (OPC UA read-only)
# C = live execution (OPC UA read + write)
MODE=A

# ── Paths ─────────────────────────────────────────────────────────────────────
DATA_DIR=./data
GNN_MODEL_PATH=./models/gat_ranker.pt

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
